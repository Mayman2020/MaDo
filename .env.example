# ================================================================
# MaDo Platform — Environment Configuration
# Copy to .env and fill in ALL values before running deploy.sh
# ================================================================

# --- Production domain ---
DOMAIN=mado.live
LETSENCRYPT_EMAIL=admin@mado.live

# --- PostgreSQL ---
POSTGRES_DB=madodb
POSTGRES_USER=mado
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Redis ---
# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
# Generate: openssl rand -hex 24
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=mado-media

# --- JWT ---
# Generate: openssl rand -hex 64  (must be >= 32 chars)
JWT_SECRET=

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Gmail SMTP) ---
MAIL_USERNAME=
# Use a Gmail App Password (not your account password)
MAIL_PASSWORD=

# --- Streaming callback secret ---
# Shared secret between nginx-rtmp HTTP hooks and the backend
# Generate: openssl rand -hex 32
STREAM_CALLBACK_SECRET=

# --- Sentry (error tracking — optional) ---
SENTRY_BACKEND_DSN=
SENTRY_FRONTEND_DSN=

# --- Monitoring (Grafana admin password) ---
GRAFANA_PASSWORD=
